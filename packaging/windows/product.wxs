<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="GoIM" Manufacturer="Ezreal-byte" Version="$(ProductVersion)"
           Scope="perMachine" InstallerVersion="500"
           UpgradeCode="73FB8334-EF13-4453-9D8C-67F7E5898388">
    <MajorUpgrade DowngradeErrorMessage="A newer version of GoIM is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Icon Id="GoIM.ico" SourceFile="$(Payload)\GoIM.ico" />
    <Property Id="ARPPRODUCTICON" Value="GoIM.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://ezreal-byte.github.io/GoIM/" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="GoIM">
        <Component Id="GoIMExecutable" Guid="*">
          <File Id="GoIMExe" Source="$(Payload)\GoIM.exe" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="GoIMStartMenuShortcut" Guid="*">
        <!-- Let the shell take the icon from the installed executable. -->
        <Shortcut Id="GoIMStartMenu" Name="GoIM" Target="[#GoIMExe]"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKMU" Key="Software\dev.goim.desktop\Installer"
                       Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        <RegistryValue Root="HKMU" Key="Software\dev.goim.desktop\Installer"
                       Name="InstallLocation" Type="string" Value="[INSTALLFOLDER]" />
      </Component>
    </StandardDirectory>

    <ComponentGroup Id="GoIMPayload" Directory="INSTALLFOLDER">
      <Files Include="!(bindpath.payload)\**">
        <Exclude Files="!(bindpath.payload)\GoIM.exe" />
      </Files>
    </ComponentGroup>
    <Feature Id="GoIM" Title="GoIM">
      <ComponentRef Id="GoIMExecutable" />
      <ComponentRef Id="GoIMStartMenuShortcut" />
      <ComponentGroupRef Id="GoIMPayload" />
    </Feature>
  </Package>
</Wix>
