@@ -0,0 +1,65 @@
+package linux
+
+import (
+	"os"
+	"os/exec"
+	"testing"
+	"time"
+
+	"github.com/vivaui/viva/ui"
+)
+
+func TestGlobalShortcutRepeatPairsDoNotRetrigger(t *testing.T) {
+	var state shortcutKeyState
+	if !state.event(xcbKeyPress, 1) || state.event(xcbKeyPress, 2) {
+		t.Fatal("detectable auto-repeat retriggered the chord")
+	}
+	state.event(xcbKeyRelease, 3)
+	if state.event(xcbKeyPress, 3) {
+		t.Fatal("core X auto-repeat pair retriggered the chord")
+	}
+	state.event(xcbKeyRelease, 4)
+	if !state.event(xcbKeyPress, 5) {
+		t.Fatal("fresh key press was suppressed")
+	}
+}
+
+func TestNativeX11GlobalShortcut(t *testing.T) {
+	if os.Getenv("VIVA_NATIVE_GLOBAL_SHORTCUT_TEST") != "1" {
+		t.Skip("requires an isolated X11 display")
+	}
+	const modifiers = ui.ModifierControl | ui.ModifierAlt | ui.ModifierShift
+	presses := make(chan struct{}, 1)
+	stop, err := RegisterGlobalShortcut(modifiers, 'g', func() { presses <- struct{}{} })
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer stop()
+	if duplicate, err := RegisterGlobalShortcut(modifiers, 'g', func() {}); err == nil {
+		duplicate()
+		t.Fatal("X11 accepted a conflicting grab")
+	}
+	if _, err := exec.LookPath("xdotool"); err != nil {
+		t.Fatal("isolated display check needs xdotool")
+	}
+	press := func(chords ...string) {
+		t.Helper()
+		if out, err := exec.Command("xdotool", append([]string{"key"}, chords...)...).CombinedOutput(); err != nil {
+			t.Fatalf("trigger on Xvfb: %v: %s", err, out)
+		}
+		select {
+		case <-presses:
+		case <-time.After(2 * time.Second):
+			t.Fatal("X11 hotkey did not dispatch")
+		}
+	}
+	press("ctrl+alt+shift+g")
+	press("Caps_Lock", "ctrl+alt+shift+g")
+	stop()
+	stop()
+	again, err := RegisterGlobalShortcut(modifiers, 'g', func() {})
+	if err != nil {
+		t.Fatalf("stop did not release the grab: %v", err)
+	}
+	again()
+}
diff --git a/internal/platform/windows/global_shortcut_windows.go b/internal/platform/windows/global_shortcut_windows.go
new file mode 100644
index 0000000..9daf977
--- /dev/null
+++ b/internal/platform/windows/global_shortcut_windows.go
@@ -0,0 +1,86 @@
+//go:build windows
+
+package windows
+
+import (
+	"fmt"
+	"runtime"
+	"sync"
+	"unsafe"
+)
+
+// RegisterGlobalShortcut uses a private, blocking Win32 message queue. The
+// thread exists only for a live registration and never polls or paints.
+func RegisterGlobalShortcut(modifiers, key uint32, pressed func()) (func(), error) {
+	registerGlobalHotKey := user.NewProc("RegisterHotKey")
+	unregisterGlobalHotKey := user.NewProc("UnregisterHotKey")
+	peekGlobalHotKeyMessage := user.NewProc("PeekMessageW")
+	if key == 0x7b {
+		return nil, fmt.Errorf("windows: F12 is reserved for debuggers")
+	}
+	type ready struct {
+		thread uintptr
+		err    error
+	}
+	started := make(chan ready, 1)
+	done := make(chan struct{})
+	events := make(chan struct{}, 1)
+	go func() {
+		runtime.LockOSThread()
+		defer runtime.UnlockOSThread()
+		defer close(done)
+		var msg message
+		peekGlobalHotKeyMessage.Call(uintptr(unsafe.Pointer(&msg)), 0, 0, 0, 0)
+		ok, _, err := registerGlobalHotKey.Call(0, 1, uintptr(modifiers|0x4000), uintptr(key))
+		if ok == 0 {
+			started <- ready{err: fmt.Errorf("windows: register global shortcut: %w", err)}
+			return
+		}
+		defer unregisterGlobalHotKey.Call(0, 1)
+		thread, _, _ := getCurrentThread.Call()
+		started <- ready{thread: thread}
+		for {
+			result, _, _ := getMessage.Call(uintptr(unsafe.Pointer(&msg)), 0, 0, 0)
+			if result == 0 || int32(result) == -1 {
+				return
+			}
+			if msg.Kind == 0x0312 {
+				select {
+				case events <- struct{}{}:
+				default:
+				}
+			}
+		}
+	}()
+	r := <-started
+	if r.err != nil {
+		return nil, r.err
+	}
+	go func() {
+		for {
+			select {
+			case <-events:
+				select {
+				case <-done:
+					return
+				default:
+				}
+				pressed()
+			case <-done:
+				return
+			}
+		}
+	}()
+	var once sync.Once
+	return func() {
+		once.Do(func() {
+			select {
+			case <-done:
+				return
+			default:
+			}
+			postThreadMessage.Call(r.thread, 0x0012, 0, 0)
+			<-done
+		})
+	}, nil
+}
