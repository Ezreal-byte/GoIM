new file mode 100644
index 0000000..23e4572
--- /dev/null
+++ b/app/global_shortcut_windows.go
@@ -0,0 +1,45 @@
+//go:build windows
+
+package app
+
+import (
+	"strconv"
+
+	windowsplatform "github.com/vivaui/viva/internal/platform/windows"
+	"github.com/vivaui/viva/ui"
+)
+
+func nativeRegisterGlobalShortcut(s GlobalShortcut, pressed func()) (func(), error) {
+	var modifiers uint32
+	if s.Modifiers&ui.ModifierAlt != 0 {
+		modifiers |= 1
+	}
+	if s.Modifiers&ui.ModifierControl != 0 {
+		modifiers |= 2
+	}
+	if s.Modifiers&ui.ModifierShift != 0 {
+		modifiers |= 4
+	}
+	if s.Modifiers&ui.ModifierMeta != 0 {
+		modifiers |= 8
+	}
+	key := uint32(0)
+	if len(s.Key) == 1 {
+		key = uint32(s.Key[0])
+	} else if s.Key[0] == 'F' {
+		n, _ := strconv.Atoi(s.Key[1:])
+		key = uint32(0x70 + n - 1)
+	} else {
+		switch s.Key {
+		case "SPACE":
+			key = 0x20
+		case "ENTER":
+			key = 0x0d
+		case "ESCAPE":
+			key = 0x1b
+		case "TAB":
+			key = 9
+		}
+	}
+	return windowsplatform.RegisterGlobalShortcut(modifiers, key, pressed)
+}
diff --git a/docs/global-shortcuts.md b/docs/global-shortcuts.md
new file mode 100644
index 0000000..844e0d3
--- /dev/null
+++ b/docs/global-shortcuts.md
@@ -0,0 +1,40 @@
+# Optional global shortcuts
+
+`Config.OnShortcut` handles keys delivered to a focused window. A tray application
+can also offer an explicit system-wide show/hide binding:
+
+```go
+stop, err := app.RegisterGlobalShortcut(app.GlobalShortcut{
+    Modifiers: ui.ModifierControl | ui.ModifierAlt,
+    Key: "G",
+}, func() {
+    if window.Hidden() { window.Show() } else { window.Hide() }
+})
+if err != nil { /* show the conflict or unsupported-platform error */ }
+if stop != nil { defer stop() }
+```
+
+Registration is optional. An application that never registers one starts no
+worker or native hotkey resource. Windows uses a blocking Win32 message queue.
+macOS uses Carbon application hotkey events. Linux/X11 uses a private XCB
+connection and a blocking wait; Caps Lock and Num Lock don't change the binding.
+`stop` releases the registration and is idempotent. Callbacks execute off the
+window thread; use thread-safe Window methods or store an event and call an
+Invalidator. Release macOS bindings as part of the application lifecycle while
+its main event loop is available (or on the main thread).
+
+Keys are ASCII letters/digits, F1–F24, Space, Enter, Escape or Tab; at least one
+modifier is required. Windows reserves F12 for debuggers and reports an error.
+Conflicts are returned to the caller, so it can retain the previous setting.
+macOS supports F1–F20 and uses ANSI key positions for letters and digits.
+Linux resolves keycodes at registration using the current X keyboard map and
+uses the usual X11 Alt (Mod1) and Super (Mod4) masks. Native Wayland and other
+backends return `app.ErrUnsupported`. XWayland cannot provide desktop-wide
+bindings for native Wayland clients.
+
+Driver runs keep registrations private. `driver.PressGlobalShortcut(binding)`
+tests the callback without registering anything with the host OS. Closing the
+Driver clears those bindings. Opt-in native lifecycle tests use
+`VIVA_NATIVE_GLOBAL_SHORTCUT_TEST=1`. The Linux test also delivers an actual
+X11 key via xdotool under a dedicated Xvfb display. The macOS test dispatches
+Carbon events to the app's handler without injecting desktop input.
diff --git a/internal/platform/darwin/global_shortcut_darwin.go b/internal/platform/darwin/global_shortcut_darwin.go
new file mode 100644
index 0000000..0482166
--- /dev/null
+++ b/internal/platform/darwin/global_shortcut_darwin.go
@@ -0,0 +1,162 @@
+package darwin
+
+/*
+#cgo LDFLAGS: -framework Carbon
+#include <Carbon/Carbon.h>
+#include <stdint.h>
+int32_t viva_global_shortcut_register(uint32_t code, uint32_t modifiers, uint32_t identifier, EventHotKeyRef *reference);
+void viva_global_shortcut_unregister(EventHotKeyRef reference);
+int32_t viva_global_shortcut_test_event(uint32_t identifier, uint32_t kind);
+*/
+import "C"
+
+import (
+	"fmt"
+	"strconv"
+	"sync"
+	"sync/atomic"
+
+	"github.com/vivaui/viva/ui"
+)
+
+type carbonShortcut struct {
+	id     uint32
+	ref    C.EventHotKeyRef
+	events chan struct{}
+	stop   chan struct{}
+	once   sync.Once
+	down   bool // main thread only
+}
+
+var nextCarbonShortcut atomic.Uint32
+var carbonShortcuts sync.Map // uint32 -> *carbonShortcut
+
+// RegisterGlobalShortcut uses the system hotkey API. It does not read other
+// keystrokes or need Accessibility or Input Monitoring permissions.
+func RegisterGlobalShortcut(modifiers ui.Modifiers, key string, pressed func()) (func(), error) {
+	binding, err := registerCarbonShortcut(modifiers, key, pressed)
+	if err != nil {
+		return nil, err
+	}
+	return binding.close, nil
+}
+
+func registerCarbonShortcut(modifiers ui.Modifiers, key string, pressed func()) (*carbonShortcut, error) {
+	code, ok := carbonKeycode(key)
+	if !ok {
+		return nil, fmt.Errorf("darwin: global shortcut key %q is unsupported", key)
+	}
+	mask := C.uint32_t(0)
+	if modifiers&ui.ModifierShift != 0 {
+		mask |= C.shiftKey
+	}
+	if modifiers&ui.ModifierControl != 0 {
+		mask |= C.controlKey
+	}
+	if modifiers&ui.ModifierAlt != 0 {
+		mask |= C.optionKey
+	}
+	if modifiers&ui.ModifierMeta != 0 {
+		mask |= C.cmdKey
+	}
+	id := nextCarbonShortcut.Add(1)
+	binding := &carbonShortcut{id: id, events: make(chan struct{}, 1), stop: make(chan struct{})}
+	carbonShortcuts.Store(id, binding)
+	var ref C.EventHotKeyRef
+	if status := C.viva_global_shortcut_register(code, mask, C.uint32_t(id), &ref); status != 0 {
+		carbonShortcuts.Delete(id)
+		return nil, fmt.Errorf("darwin: register global shortcut (OSStatus %d)", status)
+	}
+	binding.ref = ref
+	go func() {
+		for {
+			select {
+			case <-binding.stop:
+				return
+			case <-binding.events:
+				select {
+				case <-binding.stop:
+					return
+				default:
+				}
+				pressed()
+			}
+		}
+	}()
+	return binding, nil
+}
+
+func (b *carbonShortcut) close() {
+	b.once.Do(func() {
+		carbonShortcuts.Delete(b.id)
+		close(b.stop)
+		C.viva_global_shortcut_unregister(b.ref)
+	})
+}
+
+//export vivaGlobalShortcutEvent
+func vivaGlobalShortcutEvent(identifier, kind C.uint32_t) C.int {
+	value, ok := carbonShortcuts.Load(uint32(identifier))
+	if !ok {
+		return 0
+	}
+	b := value.(*carbonShortcut)
+	if kind == C.kEventHotKeyReleased {
+		b.down = false
+	} else if !b.down {
+		b.down = true
+		select {
+		case b.events <- struct{}{}:
+		default:
+		}
+	}
+	return 1
+}
+
+func carbonKeycode(key string) (C.uint32_t, bool) {
+	letters := [...]C.uint32_t{C.kVK_ANSI_A, C.kVK_ANSI_B, C.kVK_ANSI_C, C.kVK_ANSI_D, C.kVK_ANSI_E, C.kVK_ANSI_F,
+		C.kVK_ANSI_G, C.kVK_ANSI_H, C.kVK_ANSI_I, C.kVK_ANSI_J, C.kVK_ANSI_K, C.kVK_ANSI_L, C.kVK_ANSI_M,
+		C.kVK_ANSI_N, C.kVK_ANSI_O, C.kVK_ANSI_P, C.kVK_ANSI_Q, C.kVK_ANSI_R, C.kVK_ANSI_S, C.kVK_ANSI_T,
+		C.kVK_ANSI_U, C.kVK_ANSI_V, C.kVK_ANSI_W, C.kVK_ANSI_X, C.kVK_ANSI_Y, C.kVK_ANSI_Z}
+	digits := [...]C.uint32_t{C.kVK_ANSI_0, C.kVK_ANSI_1, C.kVK_ANSI_2, C.kVK_ANSI_3, C.kVK_ANSI_4,
+		C.kVK_ANSI_5, C.kVK_ANSI_6, C.kVK_ANSI_7, C.kVK_ANSI_8, C.kVK_ANSI_9}
+	functions := [...]C.uint32_t{C.kVK_F1, C.kVK_F2, C.kVK_F3, C.kVK_F4, C.kVK_F5, C.kVK_F6, C.kVK_F7,
+		C.kVK_F8, C.kVK_F9, C.kVK_F10, C.kVK_F11, C.kVK_F12, C.kVK_F13, C.kVK_F14, C.kVK_F15, C.kVK_F16,
+		C.kVK_F17, C.kVK_F18, C.kVK_F19, C.kVK_F20}
+	if len(key) == 1 {
+		c := key[0]
+		if 'A' <= c && c <= 'Z' {
+			return letters[c-'A'], true
+		}
+		if '0' <= c && c <= '9' {
+			return digits[c-'0'], true
+		}
+	}
+	if len(key) > 1 && key[0] == 'F' {
+		n, err := strconv.Atoi(key[1:])
+		if err == nil && n >= 1 && n <= len(functions) {
+			return functions[n-1], true
+		}
+	}
+	switch key {
+	case "SPACE":
+		return C.kVK_Space, true
+	case "ENTER":
+		return C.kVK_Return, true
+	case "ESCAPE":
+		return C.kVK_Escape, true
+	case "TAB":
+		return C.kVK_Tab, true
+	}
+	return 0, false
+}
+
+// sendCarbonShortcutTestEvent exercises the real application event handler
+// without injecting keyboard input into the host desktop.
+func sendCarbonShortcutTestEvent(id uint32, down bool) int32 {
+	kind := C.uint32_t(C.kEventHotKeyReleased)
+	if down {
+		kind = C.kEventHotKeyPressed
+	}
+	return int32(C.viva_global_shortcut_test_event(C.uint32_t(id), kind))
+}
diff --git a/internal/platform/darwin/global_shortcut_darwin.m b/internal/platform/darwin/global_shortcut_darwin.m
new file mode 100644
index 0000000..9e4e310
--- /dev/null
+++ b/internal/platform/darwin/global_shortcut_darwin.m
@@ -0,0 +1,81 @@
+#import <Cocoa/Cocoa.h>
+#import <Carbon/Carbon.h>
+#include <stdint.h>
+
+extern int vivaGlobalShortcutEvent(uint32_t identifier, uint32_t kind);
+
+static const OSType vivaHotKeySignature = 0x56697661; // 'Viva'
+static EventHandlerRef vivaHotKeyHandler;
+static uint32_t vivaHotKeyCount;
+
+static OSStatus viva_hot_key_event(EventHandlerCallRef next, EventRef event, void *unused) {
+    EventHotKeyID hotkey;
+    OSStatus status = GetEventParameter(event, kEventParamDirectObject, typeEventHotKeyID,
+                                        NULL, sizeof(hotkey), NULL, &hotkey);
+    if (status != noErr || hotkey.signature != vivaHotKeySignature) {
+        return eventNotHandledErr;
+    }
+    return vivaGlobalShortcutEvent(hotkey.id, GetEventKind(event)) ? noErr : eventNotHandledErr;
+}
+
+static void viva_hot_key_main(void (^work)(void)) {
+    if ([NSThread isMainThread]) {
+        work();
+    } else {
+        dispatch_sync(dispatch_get_main_queue(), work);
+    }
+}
+
+int32_t viva_global_shortcut_register(uint32_t code, uint32_t modifiers, uint32_t identifier, EventHotKeyRef *reference) {
+    __block OSStatus status = noErr;
+    viva_hot_key_main(^{
+        EventTargetRef target = GetApplicationEventTarget();
+        if (vivaHotKeyHandler == NULL) {
+            const EventTypeSpec types[] = {
+                {kEventClassKeyboard, kEventHotKeyPressed},
+                {kEventClassKeyboard, kEventHotKeyReleased},
+            };
+            status = InstallEventHandler(target, viva_hot_key_event, 2, types, NULL, &vivaHotKeyHandler);
+            if (status != noErr) {
+                return;
+            }
+        }
+        EventHotKeyID hotkey = {vivaHotKeySignature, identifier};
+        status = RegisterEventHotKey(code, modifiers, hotkey, target, 0, reference);
+        if (status == noErr) {
+            ++vivaHotKeyCount;
+        } else if (vivaHotKeyCount == 0) {
+            RemoveEventHandler(vivaHotKeyHandler);
+            vivaHotKeyHandler = NULL;
+        }
+    });
+    return status;
+}
+
+void viva_global_shortcut_unregister(EventHotKeyRef reference) {
+    viva_hot_key_main(^{
+        UnregisterEventHotKey(reference);
+        if (--vivaHotKeyCount == 0) {
+            RemoveEventHandler(vivaHotKeyHandler);
+            vivaHotKeyHandler = NULL;
+        }
+    });
+}
+
+int32_t viva_global_shortcut_test_event(uint32_t identifier, uint32_t kind) {
+    __block OSStatus status;
+    viva_hot_key_main(^{
+        EventRef event = NULL;
+        status = CreateEvent(NULL, kEventClassKeyboard, kind, GetCurrentEventTime(), kEventAttributeNone, &event);
+        if (status != noErr) {
+            return;
+        }
+        EventHotKeyID hotkey = {vivaHotKeySignature, identifier};
+        status = SetEventParameter(event, kEventParamDirectObject, typeEventHotKeyID, sizeof(hotkey), &hotkey);
+        if (status == noErr) {
+            status = SendEventToEventTarget(event, GetApplicationEventTarget());
+        }
+        ReleaseEvent(event);
+    });
+    return status;
+}
