new file mode 100644
index 0000000..2d0f298
--- /dev/null
+++ b/app/window_size.go
@@ -0,0 +1,36 @@
+package app
+
+import (
+	"errors"
+	"fmt"
+
+	"github.com/vivaui/viva/internal/platform"
+)
+
+const maximumProgrammaticWindowSize = 65535
+
+// SetSize asks the window manager to make this window's content area width by
+// height logical pixels. The request is asynchronous: OnResize reports the size
+// actually granted. The window manager may adjust or ignore a request, for
+// example in fullscreen. It is safe to call from any goroutine.
+//
+// Unsupported hosts return an error wrapping ErrUnsupported.
+func (window *Window) SetSize(width, height int) error {
+	if window == nil || window.closed.Load() {
+		return fmt.Errorf("app: window is closed")
+	}
+	if width < 1 || height < 1 || width > maximumProgrammaticWindowSize || height > maximumProgrammaticWindowSize {
+		return fmt.Errorf("app: invalid window size %dx%d", width, height)
+	}
+	sizer, ok := window.control.(platform.WindowSizer)
+	if !ok {
+		return fmt.Errorf("%w: programmatic window size", ErrUnsupported)
+	}
+	if err := sizer.SetSize(width, height); err != nil {
+		if errors.Is(err, platform.ErrWindowSizeUnsupported) {
+			return fmt.Errorf("%w: programmatic window size", ErrUnsupported)
+		}
+		return err
+	}
+	return nil
+}
diff --git a/app/window_size_native_test.go b/app/window_size_native_test.go
new file mode 100644
index 0000000..61b910e
--- /dev/null
+++ b/app/window_size_native_test.go
@@ -0,0 +1,48 @@
+//go:build windows || linux
+
+package app
+
+import (
+	"fmt"
+	"os"
+	"testing"
+	"time"
+
+	"github.com/vivaui/viva/ui"
+)
+
+func TestNativeProgrammaticWindowSize(t *testing.T) {
+	if os.Getenv("VIVA_NATIVE_WINDOW_SIZE_TEST") != "1" {
+		t.Skip("requires a native desktop session")
+	}
+	var canvas ui.Canvas
+	var got ui.Size
+	err := RunApplication(func(application *Application) error {
+		window, err := application.OpenWindow(Config{
+			Title: "Viva content resize test", Width: 320, Height: 240,
+			Paint: func(*ui.Canvas, ui.Size) {},
+			OnResize: func(size ui.Size) {
+				if size.Width >= 419 && size.Width <= 421 && size.Height >= 299 && size.Height <= 301 {
+					got = size
+					application.Quit()
+				}
+			},
+		}, &canvas)
+		if err != nil {
+			return err
+		}
+		if err := window.SetSize(420, 300); err != nil {
+			application.Quit()
+			return fmt.Errorf("request size: %w", err)
+		}
+		timer := time.AfterFunc(8*time.Second, application.Quit)
+		t.Cleanup(func() { timer.Stop() })
+		return nil
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.Width == 0 {
+		t.Fatal("native resize never reached OnResize with the requested content size")
+	}
+}
diff --git a/app/window_size_test.go b/app/window_size_test.go
new file mode 100644
index 0000000..1dc5c34
--- /dev/null
+++ b/app/window_size_test.go
@@ -0,0 +1,48 @@
+package app
+
+import (
+	"errors"
+	"testing"
+)
+
+type sizingWindow struct {
+	WindowControl
+	width, height int
+	err           error
+}
+
+func (window *sizingWindow) SetSize(width, height int) error {
+	window.width, window.height = width, height
+	return window.err
+}
+
+func TestWindowSetSizeReachesTheNativeWindow(t *testing.T) {
+	native := &sizingWindow{}
+	window := &Window{control: native}
+	if err := window.SetSize(1440, 900); err != nil {
+		t.Fatal(err)
+	}
+	if native.width != 1440 || native.height != 900 {
+		t.Fatalf("SetSize = %dx%d", native.width, native.height)
+	}
+	for _, size := range [][2]int{{0, 1}, {1, 0}, {65536, 1}, {1, 65536}} {
+		if err := window.SetSize(size[0], size[1]); err == nil {
+			t.Fatalf("invalid size %dx%d was accepted", size[0], size[1])
+		}
+	}
+	window.closed.Store(true)
+	if err := window.SetSize(800, 600); err == nil || errors.Is(err, ErrUnsupported) {
+		t.Fatalf("closed window error = %v", err)
+	}
+	var nilWindow *Window
+	if err := nilWindow.SetSize(800, 600); err == nil {
+		t.Fatal("nil window accepted SetSize")
+	}
+}
+
+func TestWindowSetSizeReportsUnsupportedHosts(t *testing.T) {
+	window := &Window{control: struct{ WindowControl }{}}
+	if err := window.SetSize(800, 600); !errors.Is(err, ErrUnsupported) {
+		t.Fatalf("unsupported host error = %v", err)
+	}
+}
