diff --git a/internal/platform/windows/status_item_windows_test.go b/internal/platform/windows/status_item_windows_test.go
index 55423e6..90b83ce 100644
--- a/internal/platform/windows/status_item_windows_test.go
+++ b/internal/platform/windows/status_item_windows_test.go
@@ -1,6 +1,7 @@
 package windows
 
 import (
+	"errors"
 	"syscall"
 	"testing"
 
@@ -8,6 +9,68 @@ import (
 	"github.com/vivaui/viva/internal/platform"
 )
 
+func TestDesktopNotificationReusesStatusItem(t *testing.T) {
+	const window = 123
+	const first, second = 2, 3
+
+	previousCall := callNotifyIcon
+	defer func() { callNotifyIcon = previousCall }()
+	notificationMu.Lock()
+	previousAdded, previousWindow := notificationAdded, notificationWindow
+	previousTargetWindow, previousTargetID := statusNotificationWindow, statusNotificationID
+	notificationAdded, notificationWindow = false, 0
+	statusNotificationWindow, statusNotificationID = 0, 0
+	notificationMu.Unlock()
+	defer func() {
+		notificationMu.Lock()
+		notificationAdded, notificationWindow = previousAdded, previousWindow
+		statusNotificationWindow, statusNotificationID = previousTargetWindow, previousTargetID
+		notificationMu.Unlock()
+	}()
+
+	status := &statusState{window: window, items: map[uint32]*statusItem{
+		first:  {id: first},
+		second: {id: second},
+	}}
+	status.publishNotificationTarget()
+
+	calls := 0
+	expectedID := uint32(first)
+	var shellErr error
+	callNotifyIcon = func(operation uintptr, data *notifyIconData) (uintptr, uintptr, error) {
+		calls++
+		if operation != notifyModify || data.Window != window || data.ID != expectedID {
+			t.Fatalf("notification operation=%d window=%d id=%d; want modify of %d/%d", operation, data.Window, data.ID, window, expectedID)
+		}
+		if data.Flags != notifyInfo || data.Icon != 0 || data.CallbackMessage != 0 || data.Tip[0] != 0 {
+			t.Fatalf("notification overwrites status item properties: flags=%#x", data.Flags)
+		}
+		if got := syscall.UTF16ToString(data.Info[:]); got != "New message" {
+			t.Fatalf("notification body = %q", got)
+		}
+		if shellErr != nil {
+			return 0, 0, shellErr
+		}
+		return 1, 0, nil
+	}
+
+	for range 3 {
+		if err := SendNotification("GoIM", "New message"); err != nil {
+			t.Fatal(err)
+		}
+	}
+	delete(status.items, first)
+	status.publishNotificationTarget()
+	expectedID = second
+	shellErr = errors.New("shell temporarily unavailable")
+	if err := SendNotification("New message", ""); !errors.Is(err, shellErr) {
+		t.Fatalf("expected the shell error, got %v", err)
+	}
+	if calls != 4 {
+		t.Fatalf("got %d shell requests for four notifications", calls)
+	}
+}
