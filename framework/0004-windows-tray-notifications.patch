+// publishNotificationTarget chooses the first live item on the event loop.
+// SendNotification can be called from other threads and needs only its key.
+func (status *statusState) publishNotificationTarget() {
+	var first uint32
+	for id, item := range status.items {
+		if !item.removed.Load() && (first == 0 || id < first) {
+			first = id
+		}
+	}
+	notificationMu.Lock()
+	defer notificationMu.Unlock()
+	statusNotificationWindow, statusNotificationID = status.window, first
+	if first != 0 {
+		removeNotificationIconLocked(notificationWindow)
+	}
+}
