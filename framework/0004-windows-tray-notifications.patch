index f565f05..7d8c4d7 100644
--- a/internal/platform/windows/status_item_windows_test.go
+++ b/internal/platform/windows/status_item_windows_test.go
@@ -1,12 +1,59 @@
 package windows
 
 import (
+	"errors"
+	"syscall"
 	"testing"
 
 	"github.com/vivaui/viva/internal/platform"
 	"github.com/vivaui/viva/ui"
 )
 
+func TestDesktopNotificationReusesStatusItem(t *testing.T) {
+	const window = 123
+	const first, second = 2, 3
+	status := &statusState{window: window, items: map[uint32]*statusItem{
+		first:  {id: first},
+		second: {id: second},
+	}}
+	t.Cleanup(func() {
+		clear(status.items)
+		status.publishNotificationTarget()
+	})
+	status.publishNotificationTarget()
+	calls := 0
+	expectedID := uint32(first)
+	var shellErr error
+	notify := func(op uintptr, data *notifyIconData) error {
+		calls++
+		if op != notifyModify || data.Window != window || data.ID != expectedID {
+			t.Fatalf("notification operation=%d window=%d id=%d; want modify of %d/%d", op, data.Window, data.ID, window, expectedID)
+		}
+		if data.Flags != notifyInfo || data.Icon != 0 || data.CallbackMessage != 0 || data.Tip[0] != 0 {
+			t.Fatalf("notification overwrites status item properties: flags=%#x", data.Flags)
+		}
+		if got := syscall.UTF16ToString(data.Info[:]); got != "New message" {
+			t.Fatalf("notification body = %q", got)
+		}
+		return shellErr
+	}
+	for range 3 {
+		if err := sendNotification("GoIM", "New message", notify); err != nil {
+			t.Fatal(err)
+		}
+	}
+	delete(status.items, first)
+	status.publishNotificationTarget()
+	expectedID = second
+	shellErr = errors.New("shell temporarily unavailable")
+	if err := sendNotification("New message", "", notify); !errors.Is(err, shellErr) {
+		t.Fatalf("expected the shell error, got %v", err)
+	}
+	if calls != 4 {
+		t.Fatalf("got %d shell requests for four notifications", calls)
+	}
+}
